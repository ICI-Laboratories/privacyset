---
import BaseLayout from './BaseLayout.astro';

interface Heading {
  depth: number;
  slug: string;
  text: string;
}

interface SummaryData {
  whatIs?: string;
  dataUsed?: string;
  purposes?: string;
  contact?: string;
}

interface Props {
  title: string;
  shortDescription: string;
  category: string;
  lastUpdated: string;
  platforms: string[];
  developer: string;
  collaboration?: string;
  summary?: SummaryData;
  accountDeletion?: {
    supported: boolean;
    email?: string;
  };
  offlineOnly?: boolean;
  slug: string;
  lang?: 'es' | 'en';
  headings: Heading[];
}

const {
  title,
  shortDescription,
  category,
  lastUpdated,
  platforms,
  developer,
  collaboration,
  summary,
  accountDeletion,
  offlineOnly,
  slug,
  lang = 'es',
  headings,
} = Astro.props;

const isEn = lang === 'en';
const filteredHeadings = headings.filter(h => h.depth === 2);
const pageTitle = isEn
  ? `${title} — Privacy Policy | ICI Laboratories`
  : `${title} — Política de Privacidad | ICI Laboratories`;

const homeHref = isEn ? '/en/' : '/';
const servicesHref = isEn ? '/en/#services' : '/#servicios';
---

<BaseLayout title={pageTitle} description={shortDescription} currentSlug={slug} lang={lang}>
  <div class="container">
    <!-- Breadcrumb -->
    <nav class="breadcrumb-nav" aria-label={isEn ? "Breadcrumb navigation" : "Ruta de navegación"}>
      <a href={homeHref}>{isEn ? "Privacy Center" : "Centro de privacidad"}</a>
      <span class="breadcrumb-separator">/</span>
      <a href={servicesHref}>{isEn ? "Services" : "Servicios"}</a>
      <span class="breadcrumb-separator">/</span>
      <span aria-current="page">{title}</span>
    </nav>

    <!-- Header Section of the Policy Document -->
    <header class="policy-header">
      <div class="header-badges">
        <span class="badge">{category}</span>
        {platforms.map(p => (
          <span class="badge badge-platform">{p}</span>
        ))}
        {offlineOnly && (
          <span class="badge" style="background: rgba(14, 107, 71, 0.10); color: var(--sara-udec-green); border: 1px solid rgba(14, 107, 71, 0.20);">
            {isEn ? "Local-first" : "Local-first"}
          </span>
        )}
      </div>

      <h1 class="policy-main-title">{title}</h1>
      <p class="policy-lead">{shortDescription}</p>

      <div class="policy-meta-bar">
        <div class="meta-item">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <circle cx="12" cy="12" r="10"></circle>
            <polyline points="12 6 12 12 16 14"></polyline>
          </svg>
          <span><strong>{isEn ? "Last updated:" : "Última actualización:"}</strong> {lastUpdated}</span>
        </div>

        <div class="meta-item">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path>
            <circle cx="12" cy="7" r="4"></circle>
          </svg>
          <span><strong>{isEn ? "Developed by:" : "Desarrollado por:"}</strong> {developer}</span>
        </div>

        {collaboration && (
          <div class="meta-item">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path>
              <circle cx="9" cy="7" r="4"></circle>
              <path d="M23 21v-2a4 4 0 0 0-3-3.87"></path>
              <path d="M16 3.13a4 4 0 0 1 0 7.75"></path>
            </svg>
            <span>{collaboration}</span>
          </div>
        )}
      </div>

      <!-- Action Toolbar -->
      <div class="action-buttons">
        <button id="copy-url-btn" class="action-btn" type="button" aria-label={isEn ? "Copy direct policy URL" : "Copiar URL directa de la política"}>
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <rect x="9" y="9" width="13" height="13" rx="2" ry="2"></rect>
            <path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"></path>
          </svg>
          <span id="copy-url-text">{isEn ? "Copy direct URL" : "Copiar URL directa"}</span>
        </button>

        <button class="action-btn" type="button" onclick="window.print()" aria-label={isEn ? "Print or save as PDF" : "Imprimir o guardar como PDF"}>
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <polyline points="6 9 6 2 18 2 18 9"></polyline>
            <path d="M6 18H4a2 2 0 0 1-2-2v-5a2 2 0 0 1 2-2h16a2 2 0 0 1 2 2v5a2 2 0 0 1-2 2h-2"></path>
            <rect x="6" y="14" width="12" height="8"></rect>
          </svg>
          <span>{isEn ? "Print / PDF" : "Imprimir / PDF"}</span>
        </button>

        {accountDeletion?.supported && (
          <a href="#eliminacion-de-cuenta" class="action-btn action-btn-accent">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M3 6h18"></path>
              <path d="M19 6v14c0 1-1 2-2 2H7c-1 0-2-1-2-2V6"></path>
              <path d="M8 6V4c0-1 1-2 2-2h4c1 0 2 1 2 2v2"></path>
            </svg>
            <span>{isEn ? "Data deletion" : "Eliminación de datos"}</span>
          </a>
        )}
      </div>
    </header>

    <!-- NIVEL 1 DE LECTURA: Resumen Inicial Estructurado -->
    {summary && (
      <section class="policy-summary-card" aria-label={isEn ? "Initial service summary" : "Resumen inicial del servicio"}>
        <div class="summary-header">
          <div class="summary-badge">
            <span class="summary-indicator"></span>
            <span>{isEn ? "Level 1 · Initial summary" : "Nivel 1 · Resumen inicial"}</span>
          </div>
          <h2 class="summary-title">{isEn ? "Privacy summary" : "Resumen de privacidad"}</h2>
          <p class="summary-notice">
            {isEn
              ? "This summary provides a fast overview of how data is handled. Full legal terms and technical specifications are detailed below in the complete document."
              : "Este resumen facilita una comprensión rápida y directa sobre el tratamiento de datos. El desglose legal y las especificaciones técnicas completas se detallan a continuación en el documento completo."}
          </p>
        </div>

        <div class="summary-grid">
          <div class="summary-cell">
            <span class="cell-label">{isEn ? "1. What is this service" : "1. Qué es este servicio"}</span>
            <p class="cell-value">{summary.whatIs}</p>
          </div>

          <div class="summary-cell">
            <span class="cell-label">{isEn ? "2. Data used" : "2. Qué datos utiliza"}</span>
            <p class="cell-value">{summary.dataUsed}</p>
          </div>

          <div class="summary-cell">
            <span class="cell-label">{isEn ? "3. Purposes" : "3. Para qué se utilizan"}</span>
            <p class="cell-value">{summary.purposes}</p>
          </div>

          <div class="summary-cell">
            <span class="cell-label">{isEn ? "4. How to contact or manage" : "4. Cómo contactar o gestionar"}</span>
            <p class="cell-value">{summary.contact}</p>
          </div>
        </div>
      </section>
    )}

    <!-- Desplegable de índice para dispositivos móviles -->
    {filteredHeadings.length > 0 && (
      <div class="mobile-toc-container">
        <details class="mobile-toc-details">
          <summary class="mobile-toc-summary">
            <span class="mobile-toc-label">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <line x1="8" y1="6" x2="21" y2="6"></line>
                <line x1="8" y1="12" x2="21" y2="12"></line>
                <line x1="8" y1="18" x2="21" y2="18"></line>
                <line x1="3" y1="6" x2="3.01" y2="6"></line>
                <line x1="3" y1="12" x2="3.01" y2="12"></line>
                <line x1="3" y1="18" x2="3.01" y2="18"></line>
              </svg>
              <span>{isEn ? `Table of contents (${filteredHeadings.length} sections)` : `Índice del documento completo (${filteredHeadings.length} secciones)`}</span>
            </span>
            <svg class="chevron-icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <polyline points="6 9 12 15 18 9"></polyline>
            </svg>
          </summary>
          <nav class="mobile-toc-nav" aria-label={isEn ? "Mobile table of contents" : "Índice desplegable móvil"}>
            <ul>
              {filteredHeadings.map(h => (
                <li>
                  <a href={`#${h.slug}`}>{h.text}</a>
                </li>
              ))}
            </ul>
          </nav>
        </details>
      </div>
    )}

    <!-- NIVEL 2 DE LECTURA: Documento Completo + Sidebar Desktop -->
    <div class="policy-layout-grid">
      <main class="policy-content-main">
        <div class="doc-level-badge">
          <span>{isEn ? "Level 2 · Complete document" : "Nivel 2 · Documento completo"}</span>
        </div>
        <article class="prose policy-content">
          <slot />
        </article>
      </main>

      {filteredHeadings.length > 0 && (
        <aside class="policy-sidebar" aria-label={isEn ? "Policy table of contents" : "Tabla de contenidos de la política"}>
          <div class="toc-sticky-box">
            <h3 class="toc-title">{isEn ? "Table of contents" : "Índice del documento"}</h3>
            <nav class="toc-nav">
              <ul>
                {filteredHeadings.map(h => (
                  <li>
                    <a href={`#${h.slug}`}>{h.text}</a>
                  </li>
                ))}
              </ul>
            </nav>
            <div class="toc-help-box">
              <p class="toc-help-text">{isEn ? "Questions about this policy?" : "¿Dudas sobre esta política?"}</p>
              <a href="mailto:icilaboratories@gmail.com" class="toc-help-link">icilaboratories@gmail.com</a>
            </div>
          </div>
        </aside>
      )}
    </div>
  </div>
</BaseLayout>

<script is:inline>
  document.addEventListener('DOMContentLoaded', () => {
    const copyBtn = document.getElementById('copy-url-btn');
    const copyText = document.getElementById('copy-url-text');
    if (copyBtn && copyText) {
      copyBtn.addEventListener('click', async () => {
        try {
          await navigator.clipboard.writeText(window.location.href);
          const original = copyText.textContent;
          copyText.textContent = copyText.textContent?.includes("Copy") ? "URL copied!" : "¡URL copiada!";
          copyBtn.style.borderColor = "var(--accent)";
          setTimeout(() => {
            copyText.textContent = original;
            copyBtn.style.borderColor = "";
          }, 2500);
        } catch (err) {
          console.error("No se pudo copiar la URL", err);
        }
      });
    }

    const mobileLinks = document.querySelectorAll('.mobile-toc-nav a');
    const details = document.querySelector('.mobile-toc-details');
    mobileLinks.forEach(link => {
      link.addEventListener('click', () => {
        if (details) details.removeAttribute('open');
      });
    });
  });
</script>

<style>
  .policy-header {
    margin-bottom: 32px;
    padding-bottom: 28px;
    border-bottom: 1px solid var(--surface-border);
  }

  .header-badges {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-bottom: 16px;
  }

  .policy-main-title {
    font-family: var(--font-display);
    font-size: clamp(1.85rem, 4vw, 2.65rem);
    font-weight: 800;
    color: var(--text-primary);
    margin-bottom: 12px;
    letter-spacing: -0.02em;
    line-height: 1.2;
  }

  .policy-lead {
    font-size: 1.1rem;
    color: var(--text-secondary);
    max-width: 820px;
    margin-bottom: 22px;
    line-height: 1.6;
  }

  .policy-meta-bar {
    display: flex;
    flex-wrap: wrap;
    gap: 18px;
    font-size: 0.85rem;
    color: var(--text-muted);
    margin-bottom: 24px;
    background: var(--surface);
    border: 1px solid var(--surface-border-subtle);
    padding: 12px 18px;
    border-radius: var(--radius-md);
  }

  .meta-item {
    display: inline-flex;
    align-items: center;
    gap: 8px;
  }

  .action-buttons {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
  }

  .action-btn {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-size: 0.85rem;
    font-weight: 600;
    padding: 8px 16px;
    border-radius: var(--radius-full);
    background: var(--surface);
    color: var(--text-secondary);
    border: 1px solid var(--surface-border);
    cursor: pointer;
    transition: all var(--transition);
  }

  .action-btn:hover {
    background: var(--surface-raised);
    color: var(--text-primary);
    border-color: var(--accent);
  }

  .action-btn-accent {
    background: var(--accent-light);
    color: var(--accent);
    border-color: var(--accent-border);
  }

  .action-btn-accent:hover {
    background: var(--accent);
    color: #FFFFFF;
  }

  /* Nivel 1 de lectura */
  .policy-summary-card {
    background: var(--surface);
    border: 1.5px solid var(--accent-border);
    border-radius: var(--radius-lg);
    padding: 28px;
    margin-bottom: 40px;
    box-shadow: var(--shadow-sm);
    position: relative;
    overflow: hidden;
  }

  .policy-summary-card::before {
    content: "";
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 4px;
    background: linear-gradient(90deg, var(--sara-sapphire-600) 0%, var(--sara-cyan-500) 100%);
  }

  .summary-badge {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    background: var(--accent-light);
    color: var(--accent);
    font-size: 0.775rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    padding: 4px 10px;
    border-radius: var(--radius-full);
    margin-bottom: 12px;
  }

  .summary-indicator {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--accent-cyan);
  }

  .summary-title {
    font-family: var(--font-display);
    font-size: 1.35rem;
    font-weight: 700;
    color: var(--text-primary);
    margin-bottom: 8px;
  }

  .summary-notice {
    font-size: 0.9rem;
    color: var(--text-muted);
    line-height: 1.5;
    margin-bottom: 22px;
  }

  .summary-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 16px;
  }

  @media (min-width: 680px) {
    .summary-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  .summary-cell {
    background: var(--bg-subtle);
    border: 1px solid var(--surface-border-subtle);
    border-radius: var(--radius-md);
    padding: 16px;
  }

  .cell-label {
    display: block;
    font-size: 0.775rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    font-weight: 700;
    color: var(--accent);
    margin-bottom: 6px;
  }

  .cell-value {
    font-size: 0.925rem;
    color: var(--text-secondary);
    line-height: 1.55;
    margin: 0;
  }

  /* Móvil TOC */
  .mobile-toc-container {
    display: block;
    margin-bottom: 32px;
  }

  @media (min-width: 1024px) {
    .mobile-toc-container {
      display: none;
    }
  }

  .mobile-toc-details {
    background: var(--surface);
    border: 1px solid var(--surface-border);
    border-radius: var(--radius-md);
    overflow: hidden;
    box-shadow: var(--shadow-sm);
  }

  .mobile-toc-summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 14px 18px;
    font-size: 0.9rem;
    font-weight: 600;
    color: var(--text-primary);
    cursor: pointer;
    user-select: none;
  }

  .mobile-toc-summary::-webkit-details-marker {
    display: none;
  }

  .mobile-toc-label {
    display: inline-flex;
    align-items: center;
    gap: 8px;
  }

  .chevron-icon {
    transition: transform var(--transition);
  }

  .mobile-toc-details[open] .chevron-icon {
    transform: rotate(180deg);
  }

  .mobile-toc-nav {
    border-top: 1px solid var(--surface-border-subtle);
    padding: 12px 18px 16px 18px;
    background: var(--bg-subtle);
  }

  .mobile-toc-nav ul {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .mobile-toc-nav a {
    font-size: 0.875rem;
    color: var(--text-secondary);
    line-height: 1.4;
    display: block;
    padding: 4px 0;
  }

  .mobile-toc-nav a:hover {
    color: var(--accent);
  }

  /* Nivel 2 */
  .doc-level-badge {
    display: inline-block;
    font-size: 0.775rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--text-muted);
    margin-bottom: 20px;
    padding-bottom: 8px;
    border-bottom: 1px dashed var(--surface-border);
    width: 100%;
  }

  .policy-layout-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 48px;
  }

  @media (min-width: 1024px) {
    .policy-layout-grid {
      grid-template-columns: minmax(0, 1fr) 280px;
    }
  }

  .policy-content-main {
    min-width: 0;
  }

  .policy-sidebar {
    display: none;
  }

  @media (min-width: 1024px) {
    .policy-sidebar {
      display: block;
    }
  }

  .toc-sticky-box {
    position: sticky;
    top: 92px;
    background: var(--surface);
    border: 1px solid var(--surface-border);
    border-radius: var(--radius-md);
    padding: 22px;
    box-shadow: var(--shadow-sm);
  }

  .toc-title {
    font-family: var(--font-display);
    font-size: 0.85rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--text-muted);
    margin-bottom: 14px;
  }

  .toc-nav ul {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 8px;
    max-height: calc(100vh - 260px);
    overflow-y: auto;
  }

  .toc-nav a {
    font-size: 0.85rem;
    color: var(--text-secondary);
    line-height: 1.4;
    display: block;
    padding: 4px 0;
    transition: color var(--transition);
  }

  .toc-nav a:hover {
    color: var(--accent);
  }

  .toc-help-box {
    margin-top: 20px;
    padding-top: 16px;
    border-top: 1px solid var(--surface-border-subtle);
    font-size: 0.8rem;
  }

  .toc-help-text {
    color: var(--text-muted);
    margin-bottom: 4px;
  }

  .toc-help-link {
    font-weight: 600;
    color: var(--accent);
  }
</style>
