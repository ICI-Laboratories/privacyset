---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  currentSlug?: string;
}

const {
  title = "Políticas de Privacidad - ICI Laboratories",
  description = "Portal oficial de políticas de privacidad para las aplicaciones móviles y servicios tecnológicos de ICI Laboratories.",
  currentSlug,
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site || "https://privacy.ici-labs.com");
---

<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="theme-color" content="#f8f7f4">
  <link rel="icon" type="image/svg+xml" href="/favicon.svg">
  <link rel="canonical" href={canonicalURL}>

  <!-- Primary Meta Tags -->
  <title>{title}</title>
  <meta name="title" content={title}>
  <meta name="description" content={description}>

  <!-- Open Graph / Facebook -->
  <meta property="og:type" content="website">
  <meta property="og:url" content={canonicalURL}>
  <meta property="og:title" content={title}>
  <meta property="og:description" content={description}>
  <meta property="og:site_name" content="ICI Laboratories">

  <!-- Twitter -->
  <meta property="twitter:card" content="summary">
  <meta property="twitter:url" content={canonicalURL}>
  <meta property="twitter:title" content={title}>
  <meta property="twitter:description" content={description}>
</head>
<body>
  <a class="skip-link" href="#contenido">Saltar al contenido principal</a>

  <Header currentSlug={currentSlug} />

  <main id="contenido" class="main-content">
    <slot />
  </main>

  <Footer />
</body>
</html>

<style>
  .main-content {
    flex: 1;
    padding-top: 40px;
    padding-bottom: 80px;
  }
</style>
