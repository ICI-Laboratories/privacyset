---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  currentSlug?: string;
  lang?: 'es' | 'en';
}

const {
  title = "Centro de privacidad · ICI Laboratories",
  description = "Consulta cómo los servicios de ICI Laboratories utilizan tus datos y cómo gestionar tu Cuenta SARA y tus solicitudes de privacidad.",
  currentSlug,
  lang = 'es',
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site || "https://privacy.ici-labs.com");
---

<!DOCTYPE html>
<html lang={lang}>
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="theme-color" content="#F4F6FB">
  <link rel="icon" type="image/svg+xml" href="/brand/logos/prisma/sara_isotipo_prisma_claro.svg">
  <link rel="canonical" href={canonicalURL}>

  <!-- Primary Meta Tags -->
  <title>{title}</title>
  <meta name="title" content={title}>
  <meta name="description" content={description}>

  <!-- Open Graph / Facebook -->
  <meta property="og:type" content="website">
  <meta property="og:url" content={canonicalURL}>
  <meta property="og:title" content={title}>
  <meta property="og:description" content={description}>
  <meta property="og:site_name" content={lang === 'en' ? "Privacy Center - ICI Laboratories" : "Centro de Privacidad - ICI Laboratories"}>

  <!-- Twitter -->
  <meta property="twitter:card" content="summary">
  <meta property="twitter:url" content={canonicalURL}>
  <meta property="twitter:title" content={title}>
  <meta property="twitter:description" content={description}>
</head>
<body>
  <!--email_off-->
  <a class="skip-link" href="#contenido">
    {lang === 'en' ? "Skip to main content" : "Saltar al contenido principal"}
  </a>

  <Header currentSlug={currentSlug} lang={lang} />

  <main id="contenido" class="main-content">
    <slot />
  </main>

  <Footer lang={lang} />
  <!--/email_off-->
</body>
</html>

<style>
  .main-content {
    flex: 1;
    padding-top: 36px;
    padding-bottom: 72px;
  }
</style>
