---
// Footer.astro
interface Props {
  lang?: 'es' | 'en';
}

const { lang = 'es' } = Astro.props;
const isEn = lang === 'en';
const currentYear = new Date().getFullYear();
---

<footer class="footer" id={isEn ? "contact" : "contacto"}>
  <div class="container footer-content">
    <div class="footer-brand">
      <p class="footer-title">{isEn ? "Privacy Center · ICI Laboratories" : "Centro de privacidad · ICI Laboratories"}</p>
      <p class="footer-desc">
        {isEn
          ? "ICI Laboratories is an independent student educational tech club for software engineering innovation. All platforms and services are operated autonomously by the club, fully disclaiming institutional liability from the University of Colima (UdeC) and FIME, and counting with the academic advisory of Dr. Walter Alexander Mata López (Director of the faculty)."
          : "ICI Laboratories es un club educativo independiente de desarrollo e innovación tecnológica. Los proyectos y plataformas son gestionados con total autonomía por el club, deslindando de cualquier responsabilidad institucional, operativa o jurídica a la Universidad de Colima (UdeC) y a la Facultad de Ingeniería Electromecánica (FIME), contando con el asesoramiento académico del Dr. Walter Alexander Mata López, director de la facultad."}
      </p>
      <div class="footer-team">
        <span>{isEn ? "Educational club · Data governance" : "Club educativo · Gobernanza de datos"}</span> &middot;
        <span>{isEn ? "Revision:" : "Revisión:"} <strong>{isEn ? "October 2026" : "Octubre 2026"}</strong></span>
      </div>
    </div>

    <div class="footer-sections">
      <div class="footer-col">
        <h4 class="footer-col-title">{isEn ? "Privacy & ARCO Requests" : "Atención y Ejercicio ARCO"}</h4>
        <ul class="footer-links-list">
          <li>
            <a href="mailto:icilaboratories@gmail.com">icilaboratories@gmail.com</a>
          </li>
          <li>
            <a href={isEn ? "/en/#account-and-data" : "/#cuenta-y-datos"}>
              {isEn ? "Deletion procedures" : "Procedimiento de eliminación"}
            </a>
          </li>
        </ul>
      </div>

      <div class="footer-col">
        <h4 class="footer-col-title">{isEn ? "Ecosystem" : "Ecosistema"}</h4>
        <ul class="footer-links-list">
          <li>
            <a href="https://auth.ici-labs.com" target="_blank" rel="noopener noreferrer">SARA ID (auth.ici-labs.com)</a>
          </li>
          <li>
            <a href="https://sara.ici-labs.com" target="_blank" rel="noopener noreferrer">SARA Web Workspace (sara.ici-labs.com)</a>
          </li>
        </ul>
      </div>
    </div>
  </div>

  <div class="container footer-bottom">
    <p>
      {isEn
        ? `© ${currentYear} ICI Laboratories · Independent educational tech club. Academic advisory: Dr. Walter Alexander Mata López (Director of FIME). Institutional disclaimer: independent from UdeC and FIME.`
        : `© ${currentYear} ICI Laboratories · Club educativo independiente. Asesoramiento académico: Dr. Walter Alexander Mata López (Director FIME). Deslinde total de responsabilidad de la Universidad de Colima y la FIME.`}
    </p>
  </div>
</footer>

<style>
  .footer {
    margin-top: auto;
    border-top: 1px solid var(--surface-border);
    background-color: var(--surface);
    padding: 48px 0 28px 0;
    font-size: 0.9rem;
    color: var(--text-muted);
  }

  .footer-content {
    display: flex;
    flex-direction: column;
    gap: 36px;
    margin-bottom: 32px;
  }

  @media (min-width: 860px) {
    .footer-content {
      flex-direction: row;
      justify-content: space-between;
      align-items: flex-start;
    }
  }

  .footer-brand {
    max-width: 520px;
  }

  .footer-title {
    font-family: var(--font-display);
    font-size: 1.05rem;
    font-weight: 700;
    color: var(--text-primary);
    margin-bottom: 8px;
  }

  .footer-desc {
    font-size: 0.875rem;
    color: var(--text-secondary);
    line-height: 1.6;
    margin-bottom: 12px;
  }

  .footer-team {
    font-size: 0.8rem;
    color: var(--text-muted);
  }

  .footer-sections {
    display: flex;
    gap: 48px;
    flex-wrap: wrap;
  }

  .footer-col {
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  .footer-col-title {
    font-size: 0.825rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    font-weight: 700;
    color: var(--text-primary);
  }

  .footer-links-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .footer-links-list a {
    font-size: 0.865rem;
    color: var(--text-secondary);
    transition: color var(--transition);
  }

  .footer-links-list a:hover {
    color: var(--accent);
  }

  .footer-bottom {
    border-top: 1px solid var(--surface-border-subtle);
    padding-top: 20px;
    font-size: 0.775rem;
    color: var(--text-muted);
    line-height: 1.5;
  }
</style>
