---
interface Props {
  slug: string;
  title: string;
  shortDescription: string;
  category: string;
  lastUpdated: string;
  platforms: string[];
  icon?: string;
  offlineOnly?: boolean;
  lang?: 'es' | 'en';
  accountDeletion?: {
    supported: boolean;
  };
}

const { slug, title, shortDescription, category, lastUpdated, platforms, icon, offlineOnly, lang = 'es', accountDeletion } = Astro.props;
const isEn = lang === 'en';
const policyHref = isEn ? `/en/${slug}/` : `/${slug}/`;
---

<article class="card app-card" data-app-card data-title={title.toLowerCase()} data-category={category.toLowerCase()} data-description={shortDescription.toLowerCase()}>
  <div class="card-header">
    <div class="app-icon-wrap" aria-hidden="true">
      {icon === 'studio' || slug === 'sara' ? (
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" width="24" height="24" fill="none">
          <path d="M4 12C4 7.58 7.58 4 12 4C16.42 4 20 7.58 20 12C20 16.42 16.42 20 12 20H5.5C4.67 20 4 19.33 4 18.5V12Z" fill="currentColor" fill-opacity="0.16" stroke="currentColor" stroke-width="1.75" stroke-linejoin="round"/>
          <path d="M12 8L13.1 10.9L16 12L13.1 13.1L12 16L10.9 13.1L8 12L10.9 10.9L12 8Z" fill="#E65642" stroke="#E65642" stroke-width="1.1" stroke-linejoin="round"/>
        </svg>
      ) : icon === 'docmd' || slug === 'sara-md' ? (
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" width="24" height="24" fill="none">
          <rect x="4" y="3.5" width="16" height="17" rx="3" fill="currentColor" fill-opacity="0.16" stroke="currentColor" stroke-width="1.75"/>
          <path d="M8 8.5H16M8 12.5H16M8 16.5H12.5" stroke="currentColor" stroke-width="1.75" stroke-linecap="round"/>
          <circle cx="15.5" cy="16.5" r="1.5" fill="#E65642"/>
        </svg>
      ) : icon === 'events' || slug === 'sara-eventos' ? (
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
          <rect x="3" y="4" width="18" height="18" rx="3" fill="currentColor" fill-opacity="0.14" />
          <line x1="16" y1="2" x2="16" y2="6"></line>
          <line x1="8" y1="2" x2="8" y2="6"></line>
          <line x1="3" y1="10" x2="21" y2="10"></line>
          <circle cx="12" cy="15" r="2" fill="#E65642" stroke="#E65642" />
        </svg>
      ) : icon === 'insitulab' || slug === 'insitulab' ? (
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
          <path d="M12 2a8 8 0 0 0-8 8c0 5.25 8 12 8 12s8-6.75 8-12a8 8 0 0 0-8-8z" fill="currentColor" fill-opacity="0.14"/>
          <circle cx="12" cy="10" r="3" fill="#0E6B47" stroke="#0E6B47"/>
        </svg>
      ) : (
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
          <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z" fill="currentColor" fill-opacity="0.14"/>
        </svg>
      )}
    </div>

    <div class="card-title-group">
      <span class="app-category">{category}</span>
      <h3 class="app-title">
        <a href={policyHref}>{title}</a>
      </h3>
    </div>
  </div>

  <p class="app-description">{shortDescription}</p>

  <div class="app-badges">
    {platforms.map(p => (
      <span class="badge badge-platform">{p}</span>
    ))}
    {offlineOnly ? (
      <span class="badge badge-offline">
        <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/>
        </svg>
        {isEn ? "Local-first" : "Local-first"}
      </span>
    ) : accountDeletion?.supported && (
      <span class="badge badge-deletion">
        <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <circle cx="12" cy="12" r="10"></circle>
          <line x1="12" y1="8" x2="12" y2="12"></line>
        </svg>
        {isEn ? "Deletion available" : "Baja disponible"}
      </span>
    )}
  </div>

  <div class="card-footer">
    <span class="last-updated">
      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <circle cx="12" cy="12" r="10"></circle>
        <polyline points="12 6 12 12 16 14"></polyline>
      </svg>
      {lastUpdated}
    </span>
    <a href={policyHref} class="read-policy-btn">
      <span>{isEn ? "Read policy" : "Leer política"}</span>
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
        <line x1="5" y1="12" x2="19" y2="12"></line>
        <polyline points="12 5 19 12 12 19"></polyline>
      </svg>
    </a>
  </div>
</article>

<style>
  .app-card {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    height: 100%;
    position: relative;
    background: var(--surface);
    border: 1px solid var(--surface-border);
    border-radius: var(--radius-lg);
    padding: 24px;
    box-shadow: var(--shadow-sm);
    transition: transform var(--transition), box-shadow var(--transition), border-color var(--transition);
  }

  .app-card:hover {
    border-color: var(--accent-border);
    box-shadow: var(--shadow-md);
    transform: translateY(-2px);
  }

  .card-header {
    display: flex;
    align-items: center;
    gap: 14px;
    margin-bottom: 14px;
  }

  .app-icon-wrap {
    width: 44px;
    height: 44px;
    border-radius: var(--radius-md);
    background: var(--bg-subtle);
    border: 1px solid var(--surface-border-subtle);
    color: var(--accent);
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }

  .card-title-group {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  .app-category {
    font-size: 0.725rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    font-weight: 700;
    color: var(--accent-cyan);
  }

  .app-title {
    font-family: var(--font-display);
    font-size: 1.25rem;
    font-weight: 700;
    letter-spacing: -0.01em;
  }

  .app-title a {
    color: var(--text-primary);
  }

  .app-title a:hover {
    color: var(--accent);
  }

  .app-description {
    font-size: 0.925rem;
    color: var(--text-secondary);
    line-height: 1.6;
    margin-bottom: 18px;
    flex-grow: 1;
  }

  .app-badges {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    margin-bottom: 20px;
  }

  .badge-offline {
    background: rgba(14, 107, 71, 0.10);
    color: var(--sara-udec-green);
    border: 1px solid rgba(14, 107, 71, 0.20);
  }

  .badge-deletion {
    background: var(--accent-light);
    color: var(--accent);
    border: 1px solid var(--accent-border);
  }

  .card-footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-top: 14px;
    border-top: 1px solid var(--surface-border-subtle);
  }

  .last-updated {
    font-size: 0.785rem;
    color: var(--text-muted);
    display: inline-flex;
    align-items: center;
    gap: 6px;
  }

  .read-policy-btn {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-size: 0.85rem;
    font-weight: 600;
    color: var(--accent);
    padding: 6px 12px;
    border-radius: var(--radius-sm);
    transition: all var(--transition);
  }

  .read-policy-btn:hover {
    background: var(--accent-light);
    transform: translateX(2px);
  }
</style>
