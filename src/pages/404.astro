---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Página no encontrada | ICI Laboratories">
  <div class="container text-center" style="text-align: center; padding: 60px 20px;">
    <span class="badge" style="margin-bottom: 16px;">Error 404</span>
    <h1 style="font-family: var(--font-serif); font-size: 3rem; margin-bottom: 16px;">Política no encontrada</h1>
    <p style="color: var(--text-secondary); max-width: 500px; margin: 0 auto 30px auto;">
      La política de privacidad que estás buscando no existe o ha sido reubicada.
    </p>
    <a href="/" class="btn" style="display: inline-flex; align-items: center; gap: 8px; background: var(--accent); color: white; padding: 10px 24px; border-radius: var(--radius-full); font-weight: 600;">
      Volver al catálogo de aplicaciones
    </a>
  </div>
</BaseLayout>
