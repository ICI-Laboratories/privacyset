---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import AppCard from '../components/AppCard.astro';

const allApps = await getCollection('apps');

// SARA ID es la cuenta central destacada
const coreApp = allApps.find(app => app.data.isCoreAccount || app.id === 'sara-id');

// Servicios restantes ordenados por el campo 'order'
const serviceApps = allApps
  .filter(app => app.id !== 'sara-id' && !app.data.isCoreAccount)
  .sort((a, b) => (a.data.order ?? 99) - (b.data.order ?? 99));
---

<BaseLayout
  title="Centro de privacidad · ICI Laboratories"
  description="Consulta cómo los servicios de ICI Laboratories utilizan tus datos y cómo gestionar tu Cuenta SARA y tus solicitudes de privacidad."
>
  <div class="container">
    <!-- 1. Presentación -->
    <section class="hero-section">
      <div class="hero-badge">
        <span class="badge-dot"></span>
        <span>Centro de privacidad &middot; ICI Laboratories</span>
      </div>
      <h1 class="hero-title">Tu información, explicada con claridad.</h1>
      <p class="hero-subtitle">
        Consulta cómo los servicios de ICI Laboratories utilizan tus datos y cómo gestionar tu cuenta y tus solicitudes de privacidad.
      </p>
    </section>

    <!-- 2. Tarjeta destacada: Cuenta SARA -->
    <section class="core-account-section" aria-label="Cuenta SARA y Servicio de Identidad">
      <div class="core-card">
        <div class="core-card-body">
          <div class="core-header-badge">
            <span class="core-chip">Identidad central</span>
          </div>

          <h2 class="core-title">¿Usas tu Cuenta SARA para iniciar sesión?</h2>
          <p class="core-desc">
            <strong>SARA ID</strong> administra tu cuenta y el acceso a las aplicaciones conectadas. Cada aplicación explica por separado cómo utiliza los datos de sus propias funciones.
          </p>

          <div class="core-features">
            <div class="core-feature-item">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/>
              </svg>
              <span>Credenciales protegidas con derivación criptográfica</span>
            </div>
            <div class="core-feature-item">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <circle cx="12" cy="12" r="10"></circle>
                <path d="M12 8v4l3 3"></path>
              </svg>
              <span>Auditoría de sesiones activas y cierres remotos</span>
            </div>
            <div class="core-feature-item">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"></path>
                <polyline points="22,6 12,13 2,6"></polyline>
              </svg>
              <span>Correo transaccional verificado vía buzón operativo</span>
            </div>
          </div>

          <div class="core-actions">
            <a href="/sara-id/" class="btn-primary">
              <span>Consultar privacidad de SARA ID</span>
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                <line x1="5" y1="12" x2="19" y2="12"></line>
                <polyline points="12 5 19 12 12 19"></polyline>
              </svg>
            </a>

            <a href="https://auth.ici-labs.com" target="_blank" rel="noopener noreferrer" class="btn-secondary">
              <span>Gestionar mi cuenta</span>
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"></path>
                <polyline points="15 3 21 3 21 9"></polyline>
                <line x1="10" y1="14" x2="21" y2="3"></line>
              </svg>
            </a>
          </div>
        </div>
      </div>
    </section>

    <!-- 3. Catálogo de servicios -->
    <section class="services-section" id="servicios">
      <div class="section-header">
        <div class="section-title-wrap">
          <h2 class="section-heading">Catálogo de servicios</h2>
          <span class="services-count">{serviceApps.length} servicios específicos</span>
        </div>
        <p class="section-subtext">
          Cada aplicación explica el tratamiento de datos conforme a sus funciones reales y su modelo operativo (en la nube o en el dispositivo).
        </p>
      </div>

      <div class="apps-grid">
        {serviceApps.map((app) => (
          <AppCard
            slug={app.id}
            title={app.data.title}
            shortDescription={app.data.shortDescription}
            category={app.data.category}
            lastUpdated={app.data.lastUpdated}
            platforms={app.data.platforms}
            icon={app.data.icon}
            offlineOnly={app.data.offlineOnly}
            accountDeletion={app.data.accountDeletion}
          />
        ))}
      </div>
    </section>

    <!-- 4. Sección “Cuenta y datos” -->
    <section class="data-management-section" id="cuenta-y-datos">
      <div class="section-header">
        <div class="section-title-wrap">
          <h2 class="section-heading">Cuenta y datos</h2>
          <span class="services-count">Gestión y derechos ARCO</span>
        </div>
        <p class="section-subtext">
          Selecciona la acción que necesitas ejercer sobre tu información personal. Todo trámite cuenta con un canal de atención formal y trazable.
        </p>
      </div>

      <div class="actions-grid">
        <!-- Entrada 1: Eliminar datos de un servicio -->
        <div class="action-card">
          <div class="action-icon-box action-icon-service">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"></path>
              <polyline points="3.27 6.96 12 12.01 20.73 6.96"></polyline>
              <line x1="12" y1="22.08" x2="12" y2="12"></line>
            </svg>
          </div>
          <h3 class="action-title">Eliminar datos de un servicio</h3>
          <p class="action-desc">
            Solicitar la eliminación de información de una aplicación concreta (como tareas o archivos de SARA, o inscripciones en SARA Eventos) sin cancelar tu acceso central.
          </p>
          <div class="action-detail">
            <strong>Cómo tramitarlo:</strong> Envía un correo con el nombre del servicio y los datos específicos que deseas depurar a <a href="mailto:icilaboratories@gmail.com">icilaboratories@gmail.com</a>.
          </div>
        </div>

        <!-- Entrada 2: Eliminar mi Cuenta SARA -->
        <div class="action-card action-card-alert">
          <div class="action-icon-box action-icon-account">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M16 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path>
              <circle cx="8.5" cy="7" r="4"></circle>
              <line x1="18" y1="8" x2="23" y2="13"></line>
              <line x1="23" y1="8" x2="18" y2="13"></line>
            </svg>
          </div>
          <h3 class="action-title">Eliminar mi Cuenta SARA</h3>
          <p class="action-desc">
            Suprime tu identidad en SARA ID y tus credenciales de inicio de sesión. <strong>Importante:</strong> Perderás de forma permanente el acceso unificado a todos los servicios conectados del laboratorio.
          </p>
          <div class="action-detail">
            <strong>Consecuencias y proceso:</strong> Los registros que deban preservarse por mandato legal o normativo escolar se mantendrán según las reglas universitarias. Consulta el <a href="/sara-id/#eliminacion-de-cuenta">procedimiento en SARA ID</a>.
          </div>
        </div>

        <!-- Entrada 3: Consultar o corregir información -->
        <div class="action-card">
          <div class="action-icon-box action-icon-access">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <circle cx="12" cy="12" r="10"></circle>
              <path d="M12 16v-4"></path>
              <path d="M12 8h.01"></path>
            </svg>
          </div>
          <h3 class="action-title">Consultar o corregir información</h3>
          <p class="action-desc">
            Actualiza datos básicos de tu perfil desde el portal de autoservicio o solicita la rectificación formal de tu correo institucional mediante el canal de derechos ARCO.
          </p>
          <div class="action-detail">
            <strong>Canal directo:</strong> Modifica tu perfil en el <a href="https://auth.ici-labs.com" target="_blank" rel="noopener noreferrer">Portal de cuenta</a> o escribe a <a href="mailto:icilaboratories@gmail.com">icilaboratories@gmail.com</a>.
          </div>
        </div>
      </div>
    </section>

    <!-- 5. Marco Institucional, Deslinde y Gobernanza -->
    <section class="institutional-section" id="acerca-de">
      <div class="inst-card">
        <div class="inst-header">
          <span class="badge" style="margin-bottom: 12px;">Transparencia y Gobernanza</span>
          <h3 class="inst-title">¿Qué es ICI Laboratories?</h3>
          <p class="inst-lead">
            <strong>ICI Laboratories</strong> es un <strong>club educativo</strong> e iniciativa de desarrollo tecnológico independiente impulsada por estudiantes. Diseñamos, programamos y operamos soluciones de software para la educación superior, herramientas de productividad y plataformas de inteligencia artificial aplicada.
          </p>
        </div>

        <div class="inst-grid-triad">
          <div class="inst-block">
            <div class="inst-block-icon" aria-hidden="true">
              <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M22 10v6M2 10l10-5 10 5-10 5z"></path>
                <path d="M6 12v5c3 3 9 3 12 0v-5"></path>
              </svg>
            </div>
            <h4 class="inst-block-title">Club Educativo</h4>
            <p class="inst-block-text">
              Comunidad técnica y formativa estudiantil. Los proyectos del ecosistema SARA surgen de la experimentación práctica en ingeniería de software, arquitectura en la nube y privacidad desde el diseño.
            </p>
          </div>

          <div class="inst-block inst-block-disclaimer">
            <div class="inst-block-icon" aria-hidden="true">
              <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path>
              </svg>
            </div>
            <h4 class="inst-block-title">Deslinde Institucional</h4>
            <p class="inst-block-text">
              ICI Laboratories opera de forma autónoma. Todas las aplicaciones, plataformas y datos son gestionados con exclusividad por el club, <strong>deslindando totalmente de cualquier responsabilidad institucional, operativa o jurídica a la Universidad de Colima (UdeC) y a la Facultad de Ingeniería Electromecánica (FIME)</strong>.
            </p>
          </div>

          <div class="inst-block">
            <div class="inst-block-icon" aria-hidden="true">
              <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"></path>
                <circle cx="9" cy="7" r="4"></circle>
                <path d="M22 21v-2a4 4 0 0 0-3-3.87"></path>
                <path d="M16 3.13a4 4 0 0 1 0 7.75"></path>
              </svg>
            </div>
            <h4 class="inst-block-title">Asesoramiento Académico</h4>
            <p class="inst-block-text">
              Contamos con el asesoramiento académico y la mentoría técnica del <strong>Dr. Walter Alexander Mata López</strong>, profesor investigador y quien además se desempeña actualmente como <strong>Director de la Facultad de Ingeniería Electromecánica (FIME)</strong>.
            </p>
          </div>
        </div>

        <div class="inst-contact-footer">
          <span>Canal oficial de gobernanza, privacidad y dudas:</span>
          <a href="mailto:icilaboratories@gmail.com" class="inst-email">icilaboratories@gmail.com</a>
        </div>
      </div>
    </section>
  </div>
</BaseLayout>

<style>
  /* ─────────────────────────────────────────────────────────────
     1. Presentación (Hero)
     ───────────────────────────────────────────────────────────── */
  .hero-section {
    text-align: center;
    max-width: 780px;
    margin: 0 auto 52px auto;
  }

  .hero-badge {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    background: var(--surface);
    border: 1px solid var(--surface-border);
    padding: 6px 16px;
    border-radius: var(--radius-full);
    font-size: 0.8rem;
    font-weight: 600;
    color: var(--text-secondary);
    margin-bottom: 22px;
    box-shadow: var(--shadow-sm);
  }

  .badge-dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--accent-cyan);
    box-shadow: 0 0 0 2px rgba(21, 154, 179, 0.25);
  }

  .hero-title {
    font-family: var(--font-display);
    font-size: clamp(2.2rem, 4.5vw, 3.2rem);
    font-weight: 800;
    color: var(--text-primary);
    line-height: 1.18;
    margin-bottom: 16px;
    letter-spacing: -0.025em;
  }

  .hero-subtitle {
    font-size: 1.125rem;
    color: var(--text-secondary);
    line-height: 1.65;
    max-width: 680px;
    margin: 0 auto;
  }

  /* ─────────────────────────────────────────────────────────────
     2. Tarjeta destacada: Cuenta SARA
     ───────────────────────────────────────────────────────────── */
  .core-account-section {
    margin-bottom: 64px;
  }

  .core-card {
    background: var(--surface);
    border: 1.5px solid var(--accent-border);
    border-radius: var(--radius-xl);
    padding: 36px 32px;
    box-shadow: var(--shadow-md);
    position: relative;
    overflow: hidden;
  }

  .core-card::before {
    content: "";
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 4px;
    background: linear-gradient(90deg, var(--sara-sapphire-600) 0%, var(--sara-cyan-500) 50%, var(--sara-coral-500) 100%);
  }

  .core-header-badge {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 16px;
    flex-wrap: wrap;
    gap: 8px;
  }

  .core-chip {
    display: inline-block;
    font-size: 0.75rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--accent);
    background: var(--accent-light);
    border: 1px solid var(--accent-border);
    padding: 4px 12px;
    border-radius: var(--radius-full);
  }

  .core-meta-updated {
    font-size: 0.8rem;
    color: var(--text-muted);
  }

  .core-title {
    font-family: var(--font-display);
    font-size: clamp(1.5rem, 3vw, 2rem);
    font-weight: 800;
    color: var(--text-primary);
    margin-bottom: 12px;
    letter-spacing: -0.015em;
  }

  .core-desc {
    font-size: 1.05rem;
    color: var(--text-secondary);
    line-height: 1.65;
    max-width: 760px;
    margin-bottom: 24px;
  }

  .core-features {
    display: grid;
    grid-template-columns: 1fr;
    gap: 12px;
    margin-bottom: 30px;
  }

  @media (min-width: 768px) {
    .core-features {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  .core-feature-item {
    display: flex;
    align-items: center;
    gap: 10px;
    font-size: 0.875rem;
    color: var(--text-secondary);
    background: var(--bg-subtle);
    padding: 12px 14px;
    border-radius: var(--radius-md);
    border: 1px solid var(--surface-border-subtle);
  }

  .core-feature-item svg {
    color: var(--accent-cyan);
    flex-shrink: 0;
  }

  .core-actions {
    display: flex;
    align-items: center;
    gap: 14px;
    flex-wrap: wrap;
  }

  .btn-primary {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    background: var(--accent);
    color: #FFFFFF;
    font-weight: 600;
    font-size: 0.95rem;
    padding: 11px 22px;
    border-radius: var(--radius-full);
    box-shadow: 0 4px 12px var(--accent-glow);
    transition: all var(--transition);
  }

  .btn-primary:hover {
    background: var(--accent-hover);
    color: #FFFFFF;
    opacity: 1;
    transform: translateY(-1px);
    box-shadow: 0 6px 16px var(--accent-glow);
  }

  .btn-secondary {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    background: var(--surface);
    color: var(--text-secondary);
    font-weight: 600;
    font-size: 0.925rem;
    padding: 10px 20px;
    border-radius: var(--radius-full);
    border: 1px solid var(--surface-border);
    transition: all var(--transition);
  }

  .btn-secondary:hover {
    color: var(--text-primary);
    border-color: var(--accent);
    background: var(--bg-subtle);
  }

  /* ─────────────────────────────────────────────────────────────
     3. Catálogo de Servicios
     ───────────────────────────────────────────────────────────── */
  .services-section {
    margin-bottom: 72px;
  }

  .section-header {
    margin-bottom: 28px;
  }

  .section-title-wrap {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    border-bottom: 1px solid var(--surface-border);
    padding-bottom: 12px;
    margin-bottom: 8px;
  }

  .section-heading {
    font-family: var(--font-display);
    font-size: 1.65rem;
    font-weight: 700;
    color: var(--text-primary);
    letter-spacing: -0.01em;
  }

  .services-count {
    font-size: 0.85rem;
    color: var(--text-muted);
    font-weight: 500;
  }

  .section-subtext {
    font-size: 0.95rem;
    color: var(--text-secondary);
    line-height: 1.5;
  }

  .apps-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 22px;
  }

  @media (min-width: 768px) {
    .apps-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  /* ─────────────────────────────────────────────────────────────
     4. Sección Cuenta y Datos
     ───────────────────────────────────────────────────────────── */
  .data-management-section {
    margin-bottom: 72px;
  }

  .actions-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 22px;
  }

  @media (min-width: 900px) {
    .actions-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  .action-card {
    background: var(--surface);
    border: 1px solid var(--surface-border);
    border-radius: var(--radius-lg);
    padding: 26px;
    display: flex;
    flex-direction: column;
    box-shadow: var(--shadow-sm);
    transition: transform var(--transition), border-color var(--transition);
  }

  .action-card:hover {
    border-color: var(--accent-border);
    transform: translateY(-2px);
  }

  .action-card-alert {
    border-color: rgba(230, 86, 66, 0.25);
  }

  .action-icon-box {
    width: 44px;
    height: 44px;
    border-radius: var(--radius-md);
    display: flex;
    align-items: center;
    justify-content: center;
    margin-bottom: 16px;
  }

  .action-icon-service {
    background: var(--accent-light);
    color: var(--accent);
  }

  .action-icon-account {
    background: rgba(230, 86, 66, 0.12);
    color: var(--accent-coral);
  }

  .action-icon-access {
    background: rgba(21, 154, 179, 0.12);
    color: var(--accent-cyan);
  }

  .action-title {
    font-family: var(--font-display);
    font-size: 1.15rem;
    font-weight: 700;
    color: var(--text-primary);
    margin-bottom: 10px;
    line-height: 1.3;
  }

  .action-desc {
    font-size: 0.9rem;
    color: var(--text-secondary);
    line-height: 1.55;
    margin-bottom: 18px;
    flex-grow: 1;
  }

  .action-detail {
    font-size: 0.825rem;
    color: var(--text-muted);
    border-top: 1px solid var(--surface-border-subtle);
    padding-top: 14px;
    line-height: 1.5;
  }

  .action-detail a {
    font-weight: 600;
    color: var(--accent);
  }

  /* ─────────────────────────────────────────────────────────────
     5. Marco Institucional, Deslinde y Gobernanza
     ───────────────────────────────────────────────────────────── */
  .institutional-section {
    margin-bottom: 56px;
  }

  .inst-card {
    background: var(--surface);
    border: 1px solid var(--surface-border);
    border-radius: var(--radius-lg);
    padding: 36px 32px;
  }

  .inst-header {
    max-width: 820px;
    margin-bottom: 32px;
  }

  .inst-title {
    font-family: var(--font-display);
    font-size: 1.6rem;
    font-weight: 700;
    color: var(--text-primary);
    margin-bottom: 12px;
  }

  .inst-lead {
    font-size: 0.975rem;
    color: var(--text-secondary);
    line-height: 1.65;
  }

  .inst-grid-triad {
    display: grid;
    grid-template-columns: 1fr;
    gap: 20px;
    margin-bottom: 28px;
  }

  @media (min-width: 880px) {
    .inst-grid-triad {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  .inst-block {
    background: var(--bg-subtle);
    border: 1px solid var(--surface-border-subtle);
    border-radius: var(--radius-md);
    padding: 22px 20px;
    display: flex;
    flex-direction: column;
  }

  .inst-block-disclaimer {
    border-color: rgba(230, 86, 66, 0.35);
    background: rgba(230, 86, 66, 0.03);
  }

  .inst-block-icon {
    color: var(--accent);
    margin-bottom: 14px;
  }

  .inst-block-disclaimer .inst-block-icon {
    color: var(--danger-text, #E65642);
  }

  .inst-block-title {
    font-size: 1rem;
    font-weight: 700;
    color: var(--text-primary);
